<div class="content-box winamp-container">
    <div class="box-header font-press" style="display: flex; justify-content: space-between;">
        <span>FAV SONG</span>
        <span style="cursor: pointer;">[X]</span>
    </div>
    
    <div class="box-body bg-black" style="padding: 15px;">
        
        <div class="lcd-screen mb-15">
            <marquee id="song-title" scrolldelay="200" class="font-vt">
                CLICK [PLAY] TO INITIALIZE
            </marquee>
        </div>

        <div id="visualizer" class="viz-container mb-15">
            </div>

        <div class="controls-row mb-10">
            <button id="btn-prev" class="win-btn font-press">|&lt;</button>
            <button id="btn-play" class="win-btn font-press">PLAY</button>
            <button id="btn-stop" class="win-btn font-press">STOP</button>
            <button id="btn-next" class="win-btn font-press">&gt;|</button>
        </div>
        
        <div class="controls-row">
            <div class="time-display font-vt">00:00</div>
            <button id="btn-like" class="win-btn font-press" style="color: red;">
                ♥ <span id="like-count">666</span>
            </button>
        </div>
        
        <audio id="audio-player" preload="none">
            <source src="/music/song.mp3" type="audio/mpeg">
        </audio>
    </div>
</div>

<style>
    /* COMPONENT-SPECIFIC STYLES */
    
    /* LCD Screen: Green text on dark background */
    .lcd-screen {
        background: #0f1f0f;
        border: 2px inset #333;
        padding: 10px;
        color: var(--acid-green);
        font-size: 18px; /* Readable size */
        text-shadow: 0 0 5px var(--acid-green);
    }

    /* Visualizer Container */
    .viz-container {
        display: flex;
        gap: 4px;
        justify-content: center;
        height: 50px; /* Taller bars */
        align-items: flex-end;
        background: #111;
        border: 1px solid #333;
        padding: 2px;
    }

    /* Controls Layout */
    .controls-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 5px;
    }

    /* Buttons: Matching the site's "sys-btn" aesthetic */
    .win-btn {
        background: silver;
        border: 2px outset white;
        font-size: 10px;
        padding: 8px 5px;
        cursor: pointer;
        flex-grow: 1;
        font-family: 'Press Start 2P', cursive;
    }
    .win-btn:active {
        border: 2px inset white;
        background: #a0a0a0;
    }
    .win-btn:hover {
        background: white;
    }

    /* Time Display */
    .time-display {
        background: black;
        color: var(--acid-green);
        border: 2px inset #555;
        padding: 5px 10px;
        font-size: 18px;
        min-width: 60px;
        text-align: center;
    }
</style>

<script>
    // DEFINE ELEMENTS
    const audio = document.getElementById('audio-player');
    const playBtn = document.getElementById('btn-play');
    const stopBtn = document.getElementById('btn-stop');
    const marquee = document.getElementById('song-title');
    const visualizer = document.getElementById('visualizer');
    const likeBtn = document.getElementById('btn-like');
    const likeCount = document.getElementById('like-count');

    // 1. GENERATE VISUALIZER BARS
    if (visualizer) {
        visualizer.innerHTML = ''; // Clear existing
        for(let i=0; i<12; i++) { // More bars
            const bar = document.createElement('div');
            bar.className = 'bar';
            bar.style.width = '100%'; 
            bar.style.height = '5px';
            bar.style.backgroundColor = i > 8 ? '#ff0000' : (i > 5 ? '#ffff00' : '#39ff14');
            bar.style.transition = 'height 0.1s ease';
            visualizer.appendChild(bar);
        }
    }

    // 2. VISUALIZER VARIABLES
    let vizInterval: any = null;

    function startVisualizer() {
        clearInterval(vizInterval);
        vizInterval = setInterval(() => {
            const bars = document.querySelectorAll('.viz-container div');
            bars.forEach((bar) => {
                const h = Math.floor(Math.random() * 40) + 5; // Taller variations
                (bar as HTMLElement).style.height = h + 'px';
            });
        }, 100);
    }

    function stopVisualizer() {
        clearInterval(vizInterval);
        const bars = document.querySelectorAll('.viz-container div');
        bars.forEach((b) => (b as HTMLElement).style.height = '5px');
    }

    // 3. PLAY BUTTON
    if (playBtn && audio && marquee) {
        playBtn.addEventListener('click', () => {
            (audio as HTMLAudioElement).play();
            marquee.innerText = "NOW PLAYING: NOW ZERO BY CLEOPATRICK";
            startVisualizer();
        });
    }

    // 4. STOP BUTTON
    if (stopBtn && audio && marquee) {
        stopBtn.addEventListener('click', () => {
            (audio as HTMLAudioElement).pause();
            (audio as HTMLAudioElement).currentTime = 0;
            marquee.innerText = "STOPPED.";
            stopVisualizer();
        });
    }

    // 5. LIKE BUTTON LOGIC
    if (likeBtn && likeCount) {
        let likes = parseInt(localStorage.getItem('my_likes') || '666');
        likeCount.innerText = likes.toString();

        likeBtn.addEventListener('click', () => {
            likes++;
            likeCount.innerText = likes.toString();
            localStorage.setItem('my_likes', likes.toString());
            
            // Glitch effect
            likeBtn.style.transform = "scale(1.1) rotate(5deg)";
            likeBtn.style.color = "#ff00ff";
            setTimeout(() => {
                likeBtn.style.transform = "scale(1) rotate(0deg)";
                likeBtn.style.color = "red";
            }, 200);
        });
    }
</script>