---
import { skillGroups, skillsPitch } from '../data/skills';
import SectionHeading from './SectionHeading.astro';
---

<section class="skills-section container" id="skills" aria-labelledby="skills-title">
  <SectionHeading id="skills-title" translationKey="section.skills" />
  <p class="skills-pitch" data-i18n="skills.pitch">
    {skillsPitch}
  </p>
  <div class="skill-groups">
    {skillGroups.map((group, groupIndex) => (
      <div class="skill-row pixel-panel">
        <h3 class="skill-category" data-i18n={`skill.${group.category}`}>
          {group.category}
        </h3>
        <ul class="skill-list" aria-label={group.category} data-i18n-aria-label={`skill.${group.category}`}>
          {group.skills.map((skill, skillIndex) => {
            const evidence = skill.evidence?.filter((item) => item.showLink !== false) ?? [];
            const evidenceId = `skill-evidence-${groupIndex}-${skillIndex}`;
            return (
              <li class="pixel-chip skill-chip">
                <span data-i18n={`skill.${skill.label}`}>{skill.label}</span>
                {evidence.length > 0 && (
                  <button
                    class="skill-evidence-trigger"
                    type="button"
                    aria-expanded="false"
                    aria-controls={evidenceId}
                    aria-label="Supporting evidence sources"
                    data-i18n-aria-label="skills.evidenceLabel"
                  >
                    <span data-i18n="skills.evidence">SRC</span>
                  </button>
                )}
                {evidence.length > 0 && (
                  <ul
                    id={evidenceId}
                    class="skill-evidence-list"
                    hidden
                    aria-label={skill.label}
                    data-i18n-aria-label={`skill.${skill.label}`}
                  >
                    {evidence.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          target={item.external ? '_blank' : undefined}
                          rel={item.external ? 'noopener noreferrer' : undefined}
                        >
                          <span data-i18n={item.translationKey}>{item.label}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>
</section>

<style>
  .skills-section {
    min-width: 0;
    margin-top: var(--section-gap);
    scroll-margin-top: var(--page-pad);
  }

  .skills-pitch {
    max-width: 68ch;
    margin-bottom: var(--space-4);
    font-size: 18px;
    font-weight: 700;
  }

  .skill-groups {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  .skill-row {
    display: flex;
    flex-direction: column;
    min-width: 0;
    gap: var(--space-2);
    padding: var(--card-padding);
  }

  .skill-row > * {
    min-width: 0;
  }

  .skill-category {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 700;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-chip {
    position: relative;
    gap: calc(var(--space-unit) / 2);
    min-height: 32px;
    padding: 6px 10px;
    font-size: 13px;
  }

  .skill-evidence-trigger {
    appearance: none;
    display: grid;
    min-width: 44px;
    min-height: 44px;
    place-items: center;
    padding: 0 calc(var(--stack-gap) / 2);
    border: var(--border-width) solid transparent;
    background: transparent;
    color: inherit;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    cursor: pointer;
  }

  .skill-evidence-trigger:hover,
  .skill-evidence-trigger:focus-visible {
    border-color: var(--ink);
    background: var(--canvas);
  }

  .skill-evidence-list {
    position: absolute;
    z-index: var(--z-skill-evidence);
    top: calc(100% + 6px);
    left: 0;
    display: grid;
    gap: calc(var(--stack-gap) / 2);
    width: max-content;
    max-width: min(20rem, calc(100vw - 2 * var(--page-pad)));
    max-height: calc(100vh - 2 * var(--page-pad));
    max-height: calc(100dvh - 2 * var(--page-pad));
    overflow-y: auto;
    margin: 0;
    padding: var(--stack-gap);
    border: var(--border-width) solid var(--ink);
    background: var(--surface);
    box-shadow: var(--hard-shadow);
    font-family: var(--font-body);
    font-size: 12px;
    line-height: 1.4;
    list-style: none;
  }

  .skill-evidence-list[hidden] {
    display: none;
  }

  .skill-evidence-list[data-placement='above'] {
    top: auto;
    bottom: calc(100% + 6px);
  }

  .skill-evidence-list a {
    overflow-wrap: anywhere;
  }

  @media (min-width: 760px) {
    .skill-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
