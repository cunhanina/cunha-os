---
import { profile } from '../data/profile';
---

<div class="dialogue-box pixel-panel">
  <h1 class="dialogue-title" data-typewriter data-i18n-aria-label="intro.dialogue" aria-label={profile.dialogue}>
    <span data-typewriter-text data-i18n="intro.dialogue">
      {profile.dialogue}
    </span>
  </h1>
  <p class="dialogue-tagline" data-i18n="intro.tagline">
    {profile.tagline}
  </p>
  <p class="dialogue-subtitle" data-i18n="intro.subtitle">
    {profile.subtitle}
  </p>
</div>

<style>
  .dialogue-box {
    padding: var(--card-padding);
  }

  .dialogue-title {
    position: relative;
    width: fit-content;
    max-width: 100%;
    padding-right: var(--stack-gap);
    margin-bottom: var(--stack-gap);
    font-size: clamp(14px, 4.5vw, 18px);
    overflow-wrap: anywhere;
  }

  .dialogue-title::after {
    position: absolute;
    right: 0;
    bottom: 5px;
    display: block;
    width: 10px;
    height: 1em;
    background: var(--ink);
    content: '';
    vertical-align: -2px;
    animation: caret-blink 1s steps(2, end) infinite;
  }

  .dialogue-tagline {
    max-width: 68ch;
    margin-bottom: var(--stack-gap);
    font-size: 18px;
    font-weight: 700;
  }

  .dialogue-subtitle {
    max-width: 68ch;
    font-size: 16px;
    overflow-wrap: anywhere;
  }

  @keyframes caret-blink {
    to {
      visibility: hidden;
    }
  }
</style>
