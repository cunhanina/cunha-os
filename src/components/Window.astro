---
const { title, id, type } = Astro.props;
---
<div id={id} class="window" style="display: none; position: absolute; top: 10%; left: 10%; width: 400px; z-index: 10;">
  <div class="title-bar" style={type === 'pokemon' ? 'background: var(--poke-red)' : ''}>
    <div class="title-bar-text">{title}</div>
    <div class="title-bar-controls">
      <button aria-label="Minimize" onclick={`minimize('${id}')`}></button>
      <button aria-label="Maximize"></button>
      <button aria-label="Close" onclick={`closeWindow('${id}')`}></button>
    </div>
  </div>
  
  <div class="window-body">
    {/* Slot allows you to inject different content for each window */}
    <slot />
  </div>
</div>

<script>
  // Simple drag logic would go here (or use a library like interact.js)
</script>