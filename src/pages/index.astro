---
import '../styles/global.css';
import Contact from '../components/Contact.astro';
import Education from '../components/Education.astro';
import Experience from '../components/Experience.astro';
import Hero from '../components/Hero.astro';
import ProjectDialog from '../components/ProjectDialog.astro';
import ProjectList from '../components/ProjectList.astro';
import Skills from '../components/Skills.astro';
import { projects, sideQuests } from '../data/projects';
import { profile } from '../data/profile';

const canonicalUrl = 'https://cunhadev.vercel.app/';
const pageTitle = 'Nina Cunha — Digital and Integrated Production Solutions Intern in Stuttgart';
const orderedProjects = [...projects].sort((first, second) => first.order - second.order);
---

<!doctype html>
<html lang="en" data-theme="ink">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={profile.metaDescription} data-i18n-content="site.description" />
    <meta name="theme-color" content="#f2f2e8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <title data-i18n="site.title">{pageTitle}</title>

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={profile.metaDescription} data-i18n-content="site.description" />
    <meta property="og:image" content={`${canonicalUrl}og-image.png`} />
    <meta property="og:image:alt" content="Pixel-art NC initials in Nina Cunha's site palette" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={profile.metaDescription} data-i18n-content="site.description" />
    <meta name="twitter:image" content={`${canonicalUrl}og-image.png`} />

    <script is:inline>
      (() => {
        let storedTheme = '';
        let storedLanguage = '';
        try {
          storedTheme = window.localStorage.getItem('nina-theme') ?? '';
          storedLanguage = window.localStorage.getItem('nina-language') ?? '';
        } catch {
          storedTheme = '';
          storedLanguage = '';
        }

        const theme = storedTheme === 'ink' || storedTheme === 'gameboy' ? storedTheme : 'ink';
        const language = storedLanguage === 'pt' || storedLanguage === 'de' ? storedLanguage : 'en';

        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.language = language;
        document.documentElement.lang = language === 'pt' ? 'pt-BR' : language;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content" data-i18n="site.skip">
      Skip to content
    </a>
    <Hero />
    <main id="main-content" tabindex="-1">
      <ProjectList projects={orderedProjects} sideQuests={sideQuests} />
      <div class="career-grid container">
        <Experience />
        <Education />
      </div>
      <Skills />
      <Contact />
    </main>
    <footer class="site-footer container">
      <p>© 2026 Nina Cunha</p>
    </footer>
    <ProjectDialog projects={orderedProjects} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>

<style>
  .career-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: stretch;
    gap: var(--section-gap);
    margin-top: var(--section-gap);
  }

  .career-grid > * {
    min-width: 0;
  }

  .career-panel {
    display: flex;
    min-width: 0;
    flex-direction: column;
    padding: var(--card-padding);
    border: var(--border-width) solid var(--ink);
    background: var(--surface);
    box-shadow: var(--hard-shadow);
  }

  @media (min-width: 900px) {
    .career-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  .site-footer {
    margin-top: var(--section-gap);
    padding-top: var(--card-padding);
    padding-bottom: max(calc(var(--section-gap) / 2), env(safe-area-inset-bottom));
    border-top: var(--border-width) solid var(--ink);
    font-size: 16px;
  }
</style>
