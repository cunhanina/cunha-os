{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "verify": "npm run check && npm run build",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{astro,css,ts}\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{astro,css,ts}\" \"*.{json,md,mjs}\"",
    "astro": "astro"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/silkscreen": "^5.3.0",
    "astro": "^5.18.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-astro"
    ],
    "singleQuote": true,
    "trailingComma": "none",
    "printWidth": 120,
    "endOfLine": "lf",
    "tabWidth": 2,
    "useTabs": false
  }
}
